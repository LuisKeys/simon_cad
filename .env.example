# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables take precedence over values in this file.

# Which provider the agent uses: claude | openai | ollama (default: claude)
SIMONCAD_PROVIDER=claude

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com

# --- Ollama (local, no key) ---
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
