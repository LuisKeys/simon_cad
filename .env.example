# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables take precedence over values in this file.
# Settings saved from the UI (Settings > Save Settings) are stored in <user config dir>/simoncad/settings.json
# (override the path with SIMONCAD_CONFIG) and take precedence over the environment.

# Primary model: the provider the agent uses: claude | openai | ollama (default: claude).
# The provider sections below are the primary model's configuration.
SIMONCAD_PROVIDER=claude

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional token prices per million tokens (see "Token prices" at the end of this file).
ANTHROPIC_INPUT_PRICE=
ANTHROPIC_CACHED_INPUT_PRICE=
ANTHROPIC_OUTPUT_PRICE=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: none|low|medium|high (OpenAI Responses API). Empty = model default.
OPENAI_REASONING_EFFORT=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_INPUT_PRICE=
OPENAI_CACHED_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=

# --- Ollama (local, no key) ---
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Context window asked of Ollama, in tokens (default 32768; 0 = the server's own setting).
# Ollama silently drops whatever does not fit, and a CAD agent turn needs ~16k tokens before any
# conversation (system prompt and tool definitions); a prompt the model only partly read is
# reported as an error instead of answered. Larger windows use more VRAM.
OLLAMA_NUM_CTX=
# Optional: true|false to declare whether OLLAMA_MODEL accepts images. Empty = what the Ollama
# server reports for the model (/api/show), or, when it cannot say, detected from the model name
# (llava, llama3.2-vision, qwen2.5vl, gemma3, minicpm-v...). When the model has no
# vision, images (and PDFs) are routed to the fallback model (below).
OLLAMA_VISION=
# Local models are never priced: their tokens are reported, never costed.

# --- Fallback model (cloud: openai | claude) ---
# Serves what the primary model cannot: attachments it cannot read, or a request whose primary
# model became unavailable (at most one hand-over per request, never back). Unset, it is
# migrated from the configuration above: the first complete cloud provider other than the
# primary (OpenAI, then Anthropic) is the fallback, enabled. Settings > Fallback Model edits it.
SIMONCAD_FALLBACK_ENABLED=
SIMONCAD_FALLBACK_PROVIDER=
# Its own configuration uses the provider variables above with this prefix, e.g.
# SIMONCAD_FALLBACK_OPENAI_MODEL, SIMONCAD_FALLBACK_ANTHROPIC_API_KEY,
# SIMONCAD_FALLBACK_OPENAI_INPUT_PRICE. A value left unset inherits the provider's value above
# (prices only when the fallback runs the same model).
# With a local primary (ollama), sending a request to the cloud fallback needs consent:
# ask (default: asked before the first remote fallback) | allow | deny.
SIMONCAD_FALLBACK_CONSENT=

# A folder of shared reusable projects (components), searched on top of the ones next to the
# open project. Must be an absolute path; empty searches only the project's own neighbourhood.
SIMONCAD_COMPONENT_LIBRARY=

# Plan -> execute -> validate -> auto-correct workflow for complex requests in the UI
# (on by default; set to off to run every request as a single agent turn).
SIMONCAD_AUTONOMOUS=

# --- Token prices ---
# Token consumption (input and output) is always measured and reported, per model, per turn
# and per session. The *_INPUT_PRICE / *_OUTPUT_PRICE values above are the cost per million
# tokens of that provider's model; they are optional. When they are set, each turn and the
# session also show an estimated cost; when they are empty, only tokens are reported — no
# cost is ever guessed. Each model is costed with the prices of the slot that ran it (primary
# or fallback). SIMONCAD_CURRENCY is just the default label the amounts are shown in (it
# performs no conversion; default USD); OPENAI_CURRENCY / ANTHROPIC_CURRENCY (and their
# SIMONCAD_FALLBACK_ versions) label one model's prices.
#
# *_CACHED_INPUT_PRICE is the reduced rate providers charge for prompt they served from their
# cache. The repeated part of an agent turn (system prompt and tool definitions) is exactly
# what gets cached, so on a long session most of the input is billed at this rate. Left empty,
# cached input is charged at the full input price: no discount is ever assumed, because
# guessing one would understate what you actually spend.
SIMONCAD_CURRENCY=USD
