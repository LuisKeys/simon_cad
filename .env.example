# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables take precedence over values in this file.
# Settings saved from the UI (Settings > Save Settings) are stored in <user config dir>/simoncad/settings.json
# (override the path with SIMONCAD_CONFIG) and take precedence over the environment.

# Which provider the agent uses: claude | openai | ollama (default: claude)
SIMONCAD_PROVIDER=claude

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional token prices per million tokens (see "Token prices" at the end of this file).
ANTHROPIC_INPUT_PRICE=
ANTHROPIC_CACHED_INPUT_PRICE=
ANTHROPIC_OUTPUT_PRICE=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: none|low|medium|high (OpenAI Responses API). Empty = model default.
OPENAI_REASONING_EFFORT=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_INPUT_PRICE=
OPENAI_CACHED_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=

# --- Ollama (local, no key) ---
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Optional: true|false to declare whether OLLAMA_MODEL accepts images. Empty = detected from the
# model name (llava, llama3.2-vision, qwen2.5vl, gemma3, minicpm-v...). When the model has no
# vision, images (and PDFs) are routed to OpenAI if configured, otherwise to Claude.
OLLAMA_VISION=
# Local models are normally free; set these only to price your own hardware.
OLLAMA_INPUT_PRICE=
OLLAMA_CACHED_INPUT_PRICE=
OLLAMA_OUTPUT_PRICE=

# A folder of shared reusable projects (components), searched on top of the ones next to the
# open project. Must be an absolute path; empty searches only the project's own neighbourhood.
SIMONCAD_COMPONENT_LIBRARY=

# Plan -> execute -> validate -> auto-correct workflow for complex requests in the UI
# (on by default; set to off to run every request as a single agent turn).
SIMONCAD_AUTONOMOUS=

# --- Token prices ---
# Token consumption (input and output) is always measured and reported, per model, per turn
# and per session. The *_INPUT_PRICE / *_OUTPUT_PRICE values above are the cost per million
# tokens of that provider's model; they are optional. When they are set, each turn and the
# session also show an estimated cost; when they are empty, only tokens are reported — no
# cost is ever guessed. SIMONCAD_CURRENCY is just the label the amounts are shown in (it
# performs no conversion; default USD).
#
# *_CACHED_INPUT_PRICE is the reduced rate providers charge for prompt they served from their
# cache. The repeated part of an agent turn (system prompt and tool definitions) is exactly
# what gets cached, so on a long session most of the input is billed at this rate. Left empty,
# cached input is charged at the full input price: no discount is ever assumed, because
# guessing one would understate what you actually spend.
SIMONCAD_CURRENCY=USD
